<Window x:Class="ClipKeep.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ClipKeep" Width="1120" Height="370" MinWidth="640" MinHeight="330"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
 Background="#F5F6FC" PreviewKeyDown="HandleKey" Deactivated="OnDeactivated">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="False">
   <TextBlock Text="ClipKeep" FontSize="22" FontWeight="Bold" Foreground="#343C82" Margin="4,0,18,0" VerticalAlignment="Center"/>
   <TextBox x:Name="SearchBox" Width="240" TextChanged="SearchChanged" ToolTip="搜索内容或来源应用"/>
   <CheckBox x:Name="FavoritesOnly" Content="仅收藏" VerticalAlignment="Center" Margin="12,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
   <Button Content="设置" Click="OpenSettings"/>
   <TextBlock x:Name="CountLabel" Margin="10,0" VerticalAlignment="Center" Foreground="#68708A"/>
  </DockPanel>
  <ListBox x:Name="Cards" Grid.Row="1" Margin="0,10" Background="Transparent" BorderThickness="0"
      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.ScrollChanged="CardsScrolled" SelectionChanged="SelectionChanged" MouseDoubleClick="DoubleClickCard">
   <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
     <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="CardBorder" BorderBrush="#DEE2EF" BorderThickness="2" CornerRadius="12" Background="White">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#6158D9"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid Width="214" Height="222" Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="#6158D9"/>
      <TextBlock Text="{Binding Star}" Foreground="#D59220" HorizontalAlignment="Right"/></DockPanel>
     <Grid Grid.Row="1" ClipToBounds="True" Margin="0,8">
      <TextBlock Text="{Binding Record.Preview}" TextWrapping="Wrap" Foreground="#252B40" FontSize="13"/>
      <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
     </Grid>
     <DockPanel Grid.Row="2"><TextBlock Text="{Binding Record.Source}" Foreground="#747D96" MaxWidth="125" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Badge}" HorizontalAlignment="Right" Foreground="#6158D9" FontWeight="SemiBold"/></DockPanel>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="StatusLabel" Foreground="#A04A23" TextWrapping="Wrap"/>
   <TextBlock Text="← → 选择   Ctrl+C 复制并关闭   Enter 粘贴   Shift+Enter 纯文本   Ctrl+D 收藏   Ctrl+Delete 删除   Esc 关闭"
      Foreground="#68708A" FontSize="11" Margin="4,5,0,0"/>
  </StackPanel>
 </Grid>
</Window>
